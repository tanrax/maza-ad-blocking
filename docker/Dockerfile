FROM alpine:3.22

# Maza stores its lists in $XDG_CONFIG_HOME/maza, so they end up in /etc/maza
ENV XDG_CONFIG_HOME=/etc
ENV URL_DNS_LIST_CUSTOM=""
# /etc/hosts is managed by Docker, maza writes its hosts list here instead
ENV MAZA_HOST_FILE=/etc/maza/hosts
# Upstream DNS servers separated by commas, empty uses /etc/resolv.conf
ENV DNS_SERVERS=""

# Install dependencies (GNU sed is required by maza)
RUN apk add --no-cache bash curl dnsmasq sed

# Add the maza script and the entrypoint
COPY maza /usr/local/bin/maza
COPY docker/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/maza /usr/local/bin/entrypoint.sh

# Configure dnsmasq to load the list generated by maza and the user configuration
# interface=* disables local-service, so clients outside the container network are answered
RUN mkdir -p /etc/maza \
    && printf '%s\n' \
        'conf-file=/etc/maza/dnsmasq.conf' \
        'conf-dir=/etc/maza/dnsmasq.d/,*.conf' \
        'interface=*' \
        > /etc/dnsmasq.conf

# Update the list once a day and restart dnsmasq to load it
RUN echo '0 3 * * * /usr/local/bin/maza update > /proc/1/fd/1 2>&1 && pkill dnsmasq' > /etc/crontabs/root

VOLUME /etc/maza

EXPOSE 53/udp 53/tcp 67/udp

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
